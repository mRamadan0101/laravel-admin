{
    "name": "mramadan0101/laravel-admin",
    "description": "Laravel admin builder for CRUD backends, maintained for PHP 8.2+ and Laravel 10-12",
    "type": "library",
    "keywords": ["laravel", "admin", "grid", "form", "adminlte"],
    "homepage": "https://github.com/mRamadan0101/laravel-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "Mohamed Ramadan",
            "email": "mramadan0101@hotmail.com",
            "homepage": "https://github.com/mRamadan0101"
        },
        {
            "name": "zsong",
            "email": "zosong@126.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/dom-crawler": "^6.0|^7.0",
        "laravel/framework": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "intervention/image": "^2.7",
        "orchestra/testbench-browser-kit": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Encore\\Admin\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Models\\": "tests/models",
            "Tests\\Controllers\\": "tests/controllers",
            "Tests\\Factories\\": "tests/factories"
        },
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "test": "./vendor/bin/phpunit"
    },
    "suggest": {
        "intervention/image": "Required to handling and manipulation upload images (^2.7).",
        "spatie/eloquent-sortable": "Required to built orderable gird."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Encore\\Admin\\AdminServiceProvider"
            ],
            "aliases": {
                "Admin": "Encore\\Admin\\Facades\\Admin"
            }
        }
    }
}
